{
    "name": "amashukov/etherscan-client-php",
    "description": "Typed Etherscan API V2 client for EVM chains — address history (normal, ERC-20 and internal transactions) over any PSR-18 client, explicit chain id, typed Value Objects with decimal-string amounts and typed failures for rate limits and configuration errors.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/AndreyMashukov/etherscan-client-php",
    "keywords": ["etherscan", "ethereum", "evm", "erc20", "block-explorer", "api", "psr-18", "blockchain", "transactions", "value-object", "php"],
    "support": {
        "issues": "https://github.com/AndreyMashukov/etherscan-client-php/issues",
        "source": "https://github.com/AndreyMashukov/etherscan-client-php"
    },
    "authors": [
        {
            "name": "Andrei Mashukov",
            "email": "a.mashukoff@gmail.com",
            "homepage": "https://github.com/AndreyMashukov"
        }
    ],
    "require": {
        "php": ">=8.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "amashukov/rector-php-rules": "^0.4",
        "friendsofphp/php-cs-fixer": "^3.50",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Amashukov\\Etherscan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Amashukov\\Etherscan\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "rector": "rector process --dry-run"
    }
}
